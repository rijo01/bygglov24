# Stripe (Bygglovskoll)
# Testnycklar hämtas i Stripe-dashboarden. Committa aldrig riktiga värden.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_BYGGLOVSKOLL=
# Tillägget "Fråga oss" — Bygglovskoll + personligt svar, 499 kr inkl. moms.
STRIPE_PRICE_BYGGLOVSKOLL_SVAR=

# Bygglovskoll bakom feature-flagga. Allt utom exakt "true" stänger tjänsten:
# sidorna och API-rutterna 404:ar, menyposten och CTA:n döljs och /bygglovskoll
# utelämnas ur sitemapen. Sätts per miljö i Vercel — Preview kan ha true medan
# Production har false.
BYGGLOVSKOLL_ENABLED=false
